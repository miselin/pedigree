###############################################################################
##### Pedigree                                                            #####
###############################################################################
timeout 10

title  Pedigree
root   (cd)
kernel /boot/kernel root=LABEL=PEDIGREE
module /boot/initrd.tar
module /boot/config.db

title  Pedigree (HDD)
root   (hd0,0)
kernel /boot/kernel root=LABEL=pedigree
module /boot/initrd.tar
module /boot/config.db
