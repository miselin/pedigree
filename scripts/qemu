#!/bin/bash

if [ "$1" = "--serial" ]; then
    shift
    CONSOLE="-display none -monitor none -serial stdio"
else
    CONSOLE="-monitor stdio"
    SERIAL_PORTS="-serial file:build/serial.txt -serial file:build/memlog.txt"
fi

if [ ! -z "$NO_SERIAL_PORTS" ]; then
    SERIAL_PORTS=""
fi

AIO="native,cache.direct=on"

if [ ! "$(uname -s)" == "Linux" ]; then
    AIO="threads"
fi

QEMU=${QEMU:-qemu-system-x86_64}
OVMF_CODE=${OVMF_CODE:-}
if [ -z "$OVMF_CODE" ]; then
    for candidate in \
        /usr/share/OVMF/OVMF_CODE.fd \
        /opt/homebrew/share/qemu/edk2-x86_64-code.fd; do
        if [ -f "$candidate" ]; then
            OVMF_CODE="$candidate"
            break
        fi
    done
fi

if [ -z "$OVMF_CODE" ] || [ ! -f "$OVMF_CODE" ]; then
    echo "OVMF_CODE is unavailable; pass OVMF_CODE=/path/to/firmware.fd" >&2
    exit 1
fi

UEFI_RUN_DIR=./build/qemu-uefi
mkdir -p "$UEFI_RUN_DIR"
cp "$OVMF_CODE" "$UEFI_RUN_DIR/OVMF_CODE.fd"

"$QEMU" \
    -machine q35 \
    -drive if=pflash,format=raw,file="$UEFI_RUN_DIR/OVMF_CODE.fd" \
    -drive file=./build/pedigree-uefi.img,if=ide,media=disk,cache=writeback,aio=$AIO,index=0,format=raw \
    -vga cirrus $CONSOLE $SERIAL_PORTS -rtc base=utc -netdev user,id=net0 -device ne2k_pci,netdev=net0 -m 512 "$@"
