diff --git a/gcc/config/pedigree.h b/gcc/config/pedigree.h
new file mode 100644
index 0000000..cd71c8e
--- /dev/null
+++ b/gcc/config/pedigree.h
@@ -0,0 +1,51 @@
+/* Target definitions for x86-64 Pedigree.  */
+
+#undef OPTION_MUSL
+#define OPTION_MUSL 1
+#undef OPTION_MUSL_P
+#define OPTION_MUSL_P(opts) 1
+
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC                                                     \
+  "%{!shared:%{static-pie:rcrt1.o%s;pie:Scrt1.o%s;:crt1.o%s}} "          \
+  "crti.o%s "                                                             \
+  "%{static:crtbeginT.o%s;shared|static-pie|pie:crtbeginS.o%s;:crtbegin.o%s}"
+
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC                                                       \
+  "%{shared|static-pie|pie:crtendS.o%s;:crtend.o%s} crtn.o%s"
+
+#undef CPLUSPLUS_CPP_SPEC
+#define CPLUSPLUS_CPP_SPEC "-D_GNU_SOURCE %(cpp)"
+
+#undef CPP_SPEC
+#define CPP_SPEC "%{posix:-D_POSIX_SOURCE} %{pthread:-D_REENTRANT}"
+
+#undef LIB_SPEC
+#define LIB_SPEC "%{pthread:-lpthread} -lc"
+
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()                 \
+  do                                             \
+    {                                            \
+      builtin_define ("__pedigree__");          \
+      builtin_define ("__PEDIGREE__");          \
+      builtin_define_std ("unix");              \
+      builtin_assert ("system=pedigree");       \
+      builtin_assert ("system=unix");           \
+    }                                            \
+  while (0)
+
+#undef TARGET_ASM_FILE_END
+#define TARGET_ASM_FILE_END file_end_indicate_exec_stack
+
+#undef LINK_SPEC
+#define LINK_SPEC                                                        \
+  "%{shared:-shared} %{static:-static} %{rdynamic:-export-dynamic} "    \
+  "%{!shared:%{!static:%{!static-pie:"                                  \
+  "-dynamic-linker /usr/lib/ld-musl-x86_64.so.1}}} "                    \
+  "%{static-pie:-static -pie --no-dynamic-linker -z text}"
+
+/* Pedigree and musl use the LP64 size_t ABI.  */
+#undef SIZE_TYPE
+#define SIZE_TYPE "long unsigned int"
