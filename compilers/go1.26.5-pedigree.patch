+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package runtime
+
+import (
+	"internal/runtime/atomic"
+	"internal/runtime/syscall/linux"
+	"unsafe"
+)
+
+// Pedigree exposes the Linux amd64 poll ABI, but not epoll or eventfd.
+// This is a level-triggered poller based on the AIX runtime backend.
+
+type pollfd struct {
+	fd      int32
+	events  int16
+	revents int16
+}
+
+const (
+	_SYS_POLL = 7
+
+	_POLLIN  = 0x0001
+	_POLLOUT = 0x0004
+	_POLLERR = 0x0008
+	_POLLHUP = 0x0010
+)
+
+//go:nosplit
+func poll(pfds *pollfd, npfds uintptr, timeout int32) (int32, uintptr) {
+	r, _, errno := linux.Syscall6(
+		_SYS_POLL,
+		uintptr(unsafe.Pointer(pfds)),
+		npfds,
+		uintptr(timeout),
+		0,
+		0,
+		0,
+	)
+	return int32(r), errno
+}
+
+var (
+	pfds           []pollfd
+	pds            []*pollDesc
+	mtxpoll        mutex
+	mtxset         mutex
+	rdwake         int32
+	wrwake         int32
+	pendingUpdates int32
+
+	netpollWakeSig atomic.Uint32
+)
+
+func netpollinit() {
+	r, w, errno := nonblockingPipe()
+	if errno != 0 {
+		println("runtime: pipe2 failed with", errno)
+		throw("runtime: netpollinit failed")
+	}
+	rdwake = r
+	wrwake = w
+
+	pfds = make([]pollfd, 1, 128)
+	pfds[0].fd = rdwake
+	pfds[0].events = _POLLIN
+
+	pds = make([]*pollDesc, 1, 128)
+}
+
+func netpollIsPollDescriptor(fd uintptr) bool {
+	return fd == uintptr(rdwake) || fd == uintptr(wrwake)
+}
+
+// netpollwakeup interrupts poll before its descriptor set is changed.
+// mtxpoll must be held.
+func netpollwakeup() {
+	if pendingUpdates != 0 {
+		return
+	}
+	pendingUpdates = 1
+	wakeNetpoll()
+}
+
+func netpollopen(fd uintptr, pd *pollDesc) int32 {
+	lock(&mtxpoll)
+	netpollwakeup()
+
+	lock(&mtxset)
+	unlock(&mtxpoll)
+
+	pd.user = uint32(len(pfds))
+	pfds = append(pfds, pollfd{fd: int32(fd)})
+	pds = append(pds, pd)
+	unlock(&mtxset)
+	return 0
+}
+
+func netpollclose(fd uintptr) int32 {
+	lock(&mtxpoll)
+	netpollwakeup()
+
+	lock(&mtxset)
+	unlock(&mtxpoll)
+
+	for i := 1; i < len(pfds); i++ {
+		if pfds[i].fd != int32(fd) {
+			continue
+		}
+
+		last := len(pfds) - 1
+		pfds[i] = pfds[last]
+		pfds = pfds[:last]
+
+		pds[i] = pds[last]
+		pds[i].user = uint32(i)
+		pds = pds[:last]
+		break
+	}
+	unlock(&mtxset)
+	return 0
+}
+
+func netpollarm(pd *pollDesc, mode int) {
+	lock(&mtxpoll)
+	netpollwakeup()
+
+	lock(&mtxset)
+	unlock(&mtxpoll)
+
+	switch mode {
+	case 'r':
+		pfds[pd.user].events |= _POLLIN
+	case 'w':
+		pfds[pd.user].events |= _POLLOUT
+	}
+	unlock(&mtxset)
+}
+
+func wakeNetpoll() {
+	var b byte
+	for {
+		n := write(uintptr(wrwake), noescape(unsafe.Pointer(&b)), 1)
+		if n == 1 || n == -_EAGAIN {
+			return
+		}
+		if n == -_EINTR {
+			continue
+		}
+		println("runtime: netpollBreak write failed with", -n)
+		throw("runtime: netpollBreak write failed")
+	}
+}
+
+// netpollBreak interrupts a blocking poll.
+func netpollBreak() {
+	if !netpollWakeSig.CompareAndSwap(0, 1) {
+		return
+	}
+	wakeNetpoll()
+}
+
+// netpoll checks for ready network connections.
+// Returns a list of goroutines that become runnable,
+// and a delta to add to netpollWaiters.
+// This must never return an empty list with a non-zero delta.
+//
+// delay < 0: blocks indefinitely
+// delay == 0: does not block, just polls
+// delay > 0: blocks for up to that many nanoseconds
+//
+//go:nowritebarrierrec
+func netpoll(delay int64) (gList, int32) {
+	var timeout int32
+	if delay < 0 {
+		timeout = -1
+	} else if delay == 0 {
+		timeout = 0
+	} else if delay < 1e6 {
+		timeout = 1
+	} else if delay < 1e15 {
+		timeout = int32(delay / 1e6)
+	} else {
+		timeout = 1e9
+	}
+
+retry:
+	lock(&mtxpoll)
+	lock(&mtxset)
+	pendingUpdates = 0
+	unlock(&mtxpoll)
+
+	n, errno := poll(&pfds[0], uintptr(len(pfds)), timeout)
+	if errno != 0 {
+		unlock(&mtxset)
+		if errno != _EINTR {
+			println("runtime: poll failed with", errno)
+			throw("runtime: netpoll failed")
+		}
+		if timeout > 0 {
+			return gList{}, 0
+		}
+		goto retry
+	}
+
+	if n != 0 && pfds[0].revents&(_POLLIN|_POLLHUP|_POLLERR) != 0 {
+		if delay != 0 {
+			var buf [16]byte
+			for read(rdwake, noescape(unsafe.Pointer(&buf[0])), int32(len(buf))) > 0 {
+			}
+			netpollWakeSig.Store(0)
+		}
+		n--
+	}
+
+	var toRun gList
+	var delta int32
+	for i := 1; i < len(pfds) && n > 0; i++ {
+		pfd := &pfds[i]
+
+		var mode int32
+		if pfd.revents&(_POLLIN|_POLLHUP|_POLLERR) != 0 {
+			mode += 'r'
+			pfd.events &^= _POLLIN
+		}
+		if pfd.revents&(_POLLOUT|_POLLHUP|_POLLERR) != 0 {
+			mode += 'w'
+			pfd.events &^= _POLLOUT
+		}
+		if mode == 0 {
+			continue
+		}
+
+		pds[i].setEventErr(pfd.revents&_POLLERR != 0, 0)
+		delta += netpollready(&toRun, pds[i], mode)
+		n--
+	}
+	unlock(&mtxset)
+	return toRun, delta
+}
