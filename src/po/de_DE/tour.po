#: src/user/applications/tour/main.cc:45
msgid "Welcome to Pedigree!"
msgstr ""

#: src/user/applications/tour/main.cc:47
msgid "This short tour introduces the filesystem and the kernel debugger."
msgstr ""

#: src/user/applications/tour/main.cc:54 src/user/applications/tour/main.cc:60
#: src/user/applications/tour/main.cc:70 src/user/applications/tour/main.cc:79
