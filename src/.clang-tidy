---
# Keep the defect-oriented checks broad, while omitting categories that are
# currently dominated by established kernel naming/API/layout conventions.
Checks:          >-
  clang-diagnostic-*,clang-analyzer-*,bugprone-*,performance-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -performance-enum-size
WarningsAsErrors: ''
# Keep diagnostics from the project headers that make up the hosted kernel and
# modules. In particular, this excludes generated build/config.h and standard
# library headers from the report.
HeaderFilterRegex: '(^|/)src/(system/include/pedigree|system/kernel|modules)(/|$)'
# These directories contain imported implementations or compatibility headers;
# their translation units may still be analyzed, but their headers should not
# dominate findings in project code.
ExcludeHeaderFilterRegex: '(^|/)src/(modules/(drivers/common/cdi|subsys/posix/(musl|include|newlib)|system/(config/sqlite3|lwip/(api|core|include|netif)))|system/kernel/(debugger/libudis86|machine/mach_pc/x86emu))(/|$)'
CheckOptions:    
  - key:             google-readability-braces-around-statements.ShortStatementLines
    value:           '1'
  - key:             google-readability-function-size.StatementThreshold
    value:           '800'
  - key:             google-readability-namespace-comments.ShortNamespaceLines
    value:           '10'
  - key:             google-readability-namespace-comments.SpacesBeforeComments
    value:           '2'
  - key:             modernize-loop-convert.MaxCopySize
    value:           '16'
  - key:             modernize-loop-convert.MinConfidence
    value:           reasonable
  - key:             modernize-loop-convert.NamingStyle
    value:           CamelCase
  - key:             modernize-pass-by-value.IncludeStyle
    value:           llvm
  - key:             modernize-replace-auto-ptr.IncludeStyle
    value:           llvm
  - key:             modernize-use-nullptr.NullMacros
    value:           'NULL'
...
