.text
.global __clone
.type   __clone,@function
# The clone child must leave through linuxCompat exit so it retires only its
# thread; the native POSIX service's exit operation terminates the process.
__clone:
    xor %eax,%eax
    mov $56,%al
    mov %rdi,%r11
    mov %rdx,%rdi
    mov %r8,%rdx
    mov %r9,%r8
    mov 8(%rsp),%r10
    mov %r11,%r9
    and $-16,%rsi
    sub $8,%rsi
    mov %rcx,(%rsi)
    syscall
    test %eax,%eax
    jnz 1f
    xor %ebp,%ebp
    pop %rdi
    call *%r9
    mov %eax,%edi
    xor %eax,%eax
    mov $60,%al
    syscall
    hlt
1:
    ret
